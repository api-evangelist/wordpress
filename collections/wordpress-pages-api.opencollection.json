{
  "opencollection": "1.0.0",
  "info": {
    "name": "WordPress REST Block Types Pages API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "wordpress_logged_in",
      "value": "{{wordpress_logged_in}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Pages",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "WordPress List Pages",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{site}/wp-json/wp/v2/pages",
            "params": [
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "Current page of the collection."
              },
              {
                "name": "per_page",
                "value": "10",
                "type": "query",
                "description": "Maximum number of items to be returned."
              },
              {
                "name": "status",
                "value": "publish",
                "type": "query",
                "description": "Limit result set to pages with a specific status."
              },
              {
                "name": "parent",
                "value": "0",
                "type": "query",
                "description": "Limit result set to pages with a specific parent ID."
              }
            ]
          },
          "docs": "Retrieves a collection of pages from the WordPress site."
        },
        {
          "info": {
            "name": "WordPress Create Page",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{site}/wp-json/wp/v2/pages",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new page. Requires authentication."
        },
        {
          "info": {
            "name": "WordPress Get Page",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{site}/wp-json/wp/v2/pages/:id",
            "params": [
              {
                "name": "id",
                "value": "2",
                "type": "path",
                "description": "Unique identifier for the page."
              }
            ]
          },
          "docs": "Retrieves a single page by ID."
        }
      ]
    }
  ],
  "bundled": true
}