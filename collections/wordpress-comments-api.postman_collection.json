            "description": {
              "content": "Retrieves a collection of comments. Public endpoint returns approved comments.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "wp",
                "v2",
                "comments"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Current page of the collection."
                },
                {
                  "disabled": false,
                  "key": "per_page",
                  "value": "10",
                  "description": "Maximum number of items to be returned."
                },
                {
                  "disabled": false,
                  "key": "post",
                  "value": "<integer>",
                  "description": "Limit result set to comments assigned to specific post IDs."
