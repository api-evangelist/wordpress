{
  "opencollection": "1.0.0",
  "info": {
    "name": "WordPress REST Block Types Search API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "wordpress_logged_in",
      "value": "{{wordpress_logged_in}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Search",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "WordPress Search Content",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{site}/wp-json/wp/v2/search",
            "params": [
              {
                "name": "search",
                "value": "WordPress API",
                "type": "query",
                "description": "Limit results to those matching a string."
              },
              {
                "name": "type",
                "value": "post",
                "type": "query",
                "description": "Limit results to items of an object type."
              },
              {
                "name": "subtype",
                "value": "post",
                "type": "query",
                "description": "Limit results to items of one or more object subtypes."
              },
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "Current page of the collection."
              },
              {
                "name": "per_page",
                "value": "10",
                "type": "query",
                "description": "Maximum number of items to return."
              }
            ]
          },
          "docs": "Searches across WordPress content types including posts, pages, and other objects."
        }
      ]
    }
  ],
  "bundled": true
}