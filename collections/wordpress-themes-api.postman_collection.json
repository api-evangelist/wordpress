          "name": "WordPress List Themes",
          "request": {
            "name": "WordPress List Themes",
            "description": {
              "content": "Retrieves a collection of installed themes. Requires authentication.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "wp",
                "v2",
                "themes"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "Limit result set to themes assigned one or more statuses."
                }
              ],
              "variable": [
                {
                  "description": "Your WordPress site hostname",
                  "type": "any",
                  "value": "{{site}}",
                  "key": "site"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
