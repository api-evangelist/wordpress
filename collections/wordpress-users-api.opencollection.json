{
  "opencollection": "1.0.0",
  "info": {
    "name": "WordPress REST Block Types Users API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "wordpress_logged_in",
      "value": "{{wordpress_logged_in}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "WordPress List Users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{site}/wp-json/wp/v2/users",
            "params": [
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "Current page of the collection."
              },
              {
                "name": "per_page",
                "value": "10",
                "type": "query",
                "description": "Maximum number of items to be returned."
              },
              {
                "name": "roles",
                "value": "administrator,editor",
                "type": "query",
                "description": "Limit result set to users matching at least one specific role."
              }
            ]
          },
          "docs": "Retrieves a collection of users. Requires authentication for most contexts."
        },
        {
          "info": {
            "name": "WordPress Get User",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{site}/wp-json/wp/v2/users/:id",
            "params": [
              {
                "name": "id",
                "value": "1",
                "type": "path",
                "description": "Unique identifier for the user."
              }
            ]
          },
          "docs": "Retrieves a single user by ID."
        }
      ]
    }
  ],
  "bundled": true
}