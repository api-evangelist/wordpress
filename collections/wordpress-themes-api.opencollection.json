{
  "opencollection": "1.0.0",
  "info": {
    "name": "WordPress REST Block Types Themes API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "wordpress_logged_in",
      "value": "{{wordpress_logged_in}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Themes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "WordPress List Themes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{site}/wp-json/wp/v2/themes",
            "params": [
              {
                "name": "status",
                "value": "active",
                "type": "query",
                "description": "Limit result set to themes assigned one or more statuses."
              }
            ]
          },
          "docs": "Retrieves a collection of installed themes. Requires authentication."
        }
      ]
    }
  ],
  "bundled": true
}