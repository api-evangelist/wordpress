{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/wordpress/refs/heads/main/json-structure/wordpress-page-input-structure.json",
  "name": "PageInput",
  "description": "Input schema for creating or updating a page",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "The title for the page",
      "example": "New Page"
    },
    "content": {
      "type": "string",
      "description": "The content for the page",
      "example": "Page content goes here."
    },
    "status": {
      "type": "string",
      "enum": [
        "publish",
        "draft",
        "private"
      ],
      "example": "publish"
    },
    "parent": {
      "type": "int32",
      "description": "The ID for the parent page",
      "example": 0
    },
    "menu_order": {
      "type": "int32",
      "description": "The order of the page",
      "example": 0
    }
  }
}