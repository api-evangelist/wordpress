{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/wordpress/refs/heads/main/json-structure/wordpress-page-structure.json",
  "name": "Page",
  "description": "A WordPress page object",
  "type": "object",
  "properties": {
    "id": {
      "type": "int32",
      "description": "Unique identifier for the page",
      "example": 2
    },
    "date": {
      "type": "datetime",
      "description": "The date the page was published in site timezone",
      "example": "2026-01-01T00:00:00"
    },
    "status": {
      "type": "string",
      "description": "A named status for the page",
      "enum": [
        "publish",
        "future",
        "draft",
        "pending",
        "private",
        "trash"
      ],
      "example": "publish"
    },
    "type": {
      "type": "string",
      "description": "Type of post",
      "example": "page"
    },
    "link": {
      "type": "string",
      "description": "URL to the page",
      "example": "https://example.com/about/"
    },
    "title": {
      "$ref": "#/components/schemas/RenderedContent"
    },
    "content": {
      "$ref": "#/components/schemas/RenderedContent"
    },
    "excerpt": {
      "$ref": "#/components/schemas/RenderedContent"
    },
    "author": {
      "type": "int32",
      "description": "The ID for the author of the page",
      "example": 1
    },
    "parent": {
      "type": "int32",
      "description": "The ID for the parent of the page",
      "example": 0
    },
    "menu_order": {
      "type": "int32",
      "description": "The order of the page in relation to other pages",
      "example": 0
    },
    "template": {
      "type": "string",
      "description": "The theme file used to display the page",
      "example": ""
    }
  }
}